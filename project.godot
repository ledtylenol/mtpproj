; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="proiect_mtp"
run/main_scene="uid://cfluv02nb8mov"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=260
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dwajoww0vt8ut"

[autoload]

Shaker="*uid://cmxany5dl0ump"
Global="*uid://hvhpx2dqjh3f"
PauseManager="*uid://ddvymdqysmwnm"
LevelHandler="*uid://boqrq1lcoyriu"
MusicHandler="*uid://cgc4ktn8g5wrx"
TimeHandler="*uid://danq8injxbsuf"

[display]

window/size/viewport_width=512
window/size/viewport_height=288
window/size/maximize_disabled=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="proiect_mtp"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdfxr/plugin.cfg", "res://addons/shaker/plugin.cfg")

[gui]

fonts/dynamic_fonts/use_oversampling=false
theme/default_font_multichannel_signed_distance_field=true
theme/custom_font="uid://b3yqc1ldnrc84"

